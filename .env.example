# Solo NOMBRES. Los valores reales van en tu entorno local (.env NO se sube) y en Render.
DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
DB_USER=
DB_PASSWORD=
JWT_SECRET=                 # mínimo 32 bytes aleatorios
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=kudos-adjuntos
BREVO_API_KEY=
MAIL_FROM=                  # remitente verificado en Brevo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # número del sandbox (confírmalo en tu consola de Twilio)
CORS_ALLOWED_ORIGIN=http://localhost:5173
SEED_DEST_CORREO=           # correo real que recibirá la evidencia
SEED_DEST_CELULAR=          # +57..., el que hizo el join al sandbox de Twilio
